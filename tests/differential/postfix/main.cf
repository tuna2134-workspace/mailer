compatibility_level = 3.6
myhostname = postfix
mydomain = example.test
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all
mydestination = example.test, localhost
mynetworks = 127.0.0.0/8, [::1]/128
relay_domains =
relayhost =
local_recipient_maps =
local_transport = discard:differential sink
default_transport = error:external delivery disabled
relay_transport = error:relay disabled
smtpd_recipient_restrictions = reject_unauth_destination
smtpd_relay_restrictions = reject_unauth_destination
smtpd_tls_security_level = may
smtpd_tls_cert_file = /certs/server.crt
smtpd_tls_key_file = /certs/server.key
smtpd_tls_loglevel = 1
smtpd_forbid_bare_newline = yes
smtpd_forbid_bare_newline_exclusions =
smtpd_command_filter =
smtpd_discard_ehlo_keywords = silent-discard
message_size_limit = 1048576
smtpd_recipient_limit = 100
maillog_file = /dev/stdout
